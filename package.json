{
  "name": "deckyvibrancehdr",
  "version": "1.1.0",
  "description": "DeckyLoader plugin: saturation control for SDR and HDR content under gamescope",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs",
    "verify:package": "python scripts/verify_package.py && node --test tests/build-contract.test.mjs",
    "test": "node --test tests/state-sync.test.mjs tests/package-failure.test.mjs"
  },
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "rollup": "^4.0.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  }
}
